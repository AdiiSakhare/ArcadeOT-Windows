<Window x:Class="ArcadeOT.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ArcadeOT — Industrial workspace" Width="1460" Height="930" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#121E30" Padding="20,28">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="arcadeOT" Foreground="White" FontSize="30" FontWeight="Bold"/>
     <TextBlock Text="INDUSTRIAL WORKSPACE" Foreground="#8DA3BD" FontSize="10" Margin="2,8,0,36"/>
     <TextBlock Text="YOUR CONTROLLERS" Foreground="#8DA3BD" FontSize="10" FontWeight="Bold" Margin="0,0,0,14"/>
     <Button Content="＋  Add controller" Command="{Binding AddPlcCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
     <Border Background="#20334A" CornerRadius="8" Padding="13"><StackPanel><TextBlock Text="Read-only acquisition" Foreground="#8DE0CB" FontWeight="SemiBold"/><TextBlock Text="The service keeps collecting when this window closes." TextWrapping="Wrap" Foreground="#B1C0D3" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
     <TextBlock Text="v0.3 · commissioning build" Foreground="#8DA3BD" FontSize="11" Margin="0,18,0,0"/>
    </StackPanel>
    <ListBox IsEnabled="{Binding IsReady}" ItemsSource="{Binding Configuration.Plcs}" SelectedItem="{Binding SelectedPlc}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Model}" Foreground="#8DA3BD" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Host}" Foreground="#8DA3BD" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Reload" Command="{Binding ReloadCommand}"/><Button Content="Save &amp; apply" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
    <StackPanel><TextBlock Text="Production workspace" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Configure the connection. Map the signal. Keep the evidence." Foreground="#6B778C" Margin="0,7,0,0"/></StackPanel>
   </DockPanel>
   <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,22">
    <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="COLLECTOR" Foreground="#6B778C" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding ServiceState}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="LOCAL BUFFER" Foreground="#6B778C" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding BufferState}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACQUISITION" Foreground="#6B778C" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding ReadingState}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
   </UniformGrid>
   <TabControl Grid.Row="2" Background="White" BorderBrush="#DEE5EE" x:Name="WorkspaceTabs" IsEnabled="{Binding IsReady}">
    <TabItem Header="Connection">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
      <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Clone" Command="{Binding ClonePlcCommand}"/><Button Content="Remove" Command="{Binding RemovePlcCommand}"/></StackPanel><TextBlock Text="Controller setup" FontSize="21" FontWeight="SemiBold"/></DockPanel>
      <TextBlock Text="Add a controller from the sidebar, then enter the installation's actual settings." TextWrapping="Wrap" Foreground="#6B778C" Margin="0,10,0,4"/>
      <Grid IsEnabled="{Binding HasSelection}">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Controller name" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.Name}"/>
        <TextBlock Text="Manufacturer / PLC family" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SelectedPlc.ProfileId}"/>
        <TextBlock Text="Exact CPU order code (operator supplied)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.Model}"/>
        <TextBlock Text="Firmware" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.Firmware}"/>
        <TextBlock Text="Network interface / module" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.Interface}"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="PLC IP address / hostname" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.Host}"/>
        <TextBlock Text="Configured SLMP TCP port" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.Port, ValidatesOnExceptions=True}"/>
        <TextBlock Text="Frame encoding" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding FrameModes}" SelectedItem="{Binding SelectedPlc.FrameMode}"/>
        <TextBlock Text="Polling interval (ms)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.PollMs, ValidatesOnExceptions=True}"/>
        <TextBlock Text="Response timeout (ms)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding SelectedPlc.TimeoutMs, ValidatesOnExceptions=True}"/>
       </StackPanel>
      </Grid>
      <CheckBox Content="Enable read-only collection after saving" IsChecked="{Binding SelectedPlc.Enabled}" IsEnabled="{Binding HasSelection}" Margin="0,22,0,16"/>
      <Border Background="#EDF7F5" Padding="16" CornerRadius="8"><TextBlock Text="Only SLMP 3E TCP is implemented in this preview. Other families are research entries. Model labels and physical terminals are operator references; no hardware is certified by selection." TextWrapping="Wrap" Foreground="#275F57"/></Border>
      <StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Read first saved mapping" Command="{Binding TestReadCommand}"/><TextBlock Text="Saves no PLC changes · persists the returned observation" VerticalAlignment="Center" Foreground="#6B778C"/></StackPanel>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="Sensors">
     <DockPanel Margin="18">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="Sensor workspace" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="D/M labels are decimal. X/Y labels are octal. Physical pins do not determine register addresses." Foreground="#6B778C" Margin="0,8,0,18" TextWrapping="Wrap"/><WrapPanel Margin="0,0,0,14"><Button Content="Add sensor" Command="{Binding AddSensorCommand}"/><Button Content="Add repeated group" Command="{Binding BulkCommand}"/><Button Content="Import CSV…" Command="{Binding ImportCsvCommand}"/><Button Content="Remove selected" Command="{Binding RemoveSensorCommand}"/></WrapPanel></StackPanel>
      <DataGrid x:Name="SensorsGrid" ItemsSource="{Binding SelectedPlc.Sensors}" SelectedItem="{Binding SelectedSensor}" CanUserDeleteRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Sensor name" Binding="{Binding Name}" Width="160"/>
        <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="110"/>
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="90"/>
        <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" x:Name="TypeColumn" Width="100"/>
        <DataGridTextColumn Header="Scale" Binding="{Binding Scale, ValidatesOnExceptions=True}" Width="80"/>
        <DataGridTextColumn Header="Offset" Binding="{Binding Offset, ValidatesOnExceptions=True}" Width="80"/>
        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="75"/>
        <DataGridCheckBoxColumn Header="Swap words" Binding="{Binding SwapWords}" Width="95"/>
        <DataGridTextColumn Header="Min" Binding="{Binding Min, ValidatesOnExceptions=True}" Width="80"/>
        <DataGridTextColumn Header="Max" Binding="{Binding Max, ValidatesOnExceptions=True}" Width="80"/>
        <DataGridTextColumn Header="Stable ID" Binding="{Binding Id}" Width="240"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="I/O references">
     <DockPanel Margin="18">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="Physical signal references" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Enter exact module/channel/terminal references from the hardware manual. All entries are unverified operator metadata. The collector reads the separate sensor address; it does not configure electrical I/O." TextWrapping="Wrap" Foreground="#6B778C" Margin="0,10,0,18"/></StackPanel>
      <DataGrid x:Name="IoGrid" ItemsSource="{Binding SelectedPlc.Sensors}" CanUserDeleteRows="False"><DataGrid.Columns>
       <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" IsReadOnly="True" Width="150"/>
       <DataGridTextColumn Header="Module SKU" Binding="{Binding ModuleSku}" Width="150"/>
       <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="70"/>
       <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="80"/>
       <DataGridTextColumn Header="Terminal / pin" Binding="{Binding Terminal}" Width="110"/>
       <DataGridTextColumn Header="Common" Binding="{Binding Common}" Width="90"/>
       <DataGridTextColumn Header="Signal / range" Binding="{Binding Signal}" Width="130"/>
       <DataGridTextColumn Header="Sensor model" Binding="{Binding SensorModel}" Width="150"/>
       <DataGridTextColumn Header="Manual edition / page" Binding="{Binding ManualReference}" Width="220"/>
      </DataGrid.Columns></DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Live monitor">
     <DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Live observations" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Only persisted observations appear here. Blank values represent missing data." Foreground="#6B778C" Margin="0,8,0,14"/></StackPanel>
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
       <DataGrid ItemsSource="{Binding Live}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="PLC" Binding="{Binding PlcId}" Width="120"/><DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="145"/><DataGridTextColumn Header="Address" Binding="{Binding Address}"/><DataGridTextColumn Header="Raw" Binding="{Binding Raw}"/><DataGridTextColumn Header="Value" Binding="{Binding Value}"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}"/><DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="125"/><DataGridTextColumn Header="Observed UTC" Binding="{Binding ObservedAtUtc, StringFormat=O}" Width="220"/><DataGridTextColumn Header="Raw hex" Binding="{Binding RawHex}"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240"/></DataGrid.Columns></DataGrid>
       <DataGrid Grid.Row="1" ItemsSource="{Binding PlcHealth}" IsReadOnly="True" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="PLC ID" Binding="{Binding PlcId}" Width="200"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="140"/><DataGridTextColumn Header="Cycle (ms)" Binding="{Binding CycleMs, StringFormat=F1}" Width="100"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid>
      </Grid>
     </DockPanel>
    </TabItem>
    <TabItem Header="History">
     <DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Stored observations" FontSize="21" FontWeight="SemiBold"/><WrapPanel Margin="0,18,0,14"><Button Content="Latest 200" Command="{Binding LoadHistoryCommand}"/><Button Content="Older page" Command="{Binding OlderHistoryCommand}"/><Button Content="Export latest 10,000 CSV…" Command="{Binding ExportReadingsCommand}"/></WrapPanel></StackPanel><DataGrid ItemsSource="{Binding History}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="PLC" Binding="{Binding PlcId}" Width="160"/><DataGridTextColumn Header="Sensor ID" Binding="{Binding SensorId}" Width="220"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/><DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="140"/><DataGridTextColumn Header="Observed UTC" Binding="{Binding ObservedAtUtc, StringFormat=O}" Width="220"/><DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel>
    </TabItem>
    <TabItem Header="Site &amp; delivery">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
      <TextBlock Text="Site, storage &amp; delivery" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Site ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Configuration.SiteId}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Acknowledged history retention (days)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Configuration.RetentionDays, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Buffer capacity (MiB)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Configuration.MaxBufferMb, ValidatesOnExceptions=True}"/></StackPanel></Grid>
      <TextBlock Text="HTTPS ingestion URL (optional)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Configuration.CloudUrl}"/>
      <TextBlock Text="Cloud bearer token — stored separately from configuration" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Set credential" Command="{Binding SetCredentialCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><PasswordBox x:Name="CloudSecret" Padding="10,8"/></DockPanel>
      <TextBlock Text="{Binding UploadState}" TextWrapping="Wrap" Foreground="#6B778C" Margin="0,14,0,14"/>
      <TextBlock Text="Pending events are retained until explicit cloud acknowledgment. CSV export does not acknowledge them. At the buffer or free-disk limit collection pauses visibly." TextWrapping="Wrap" Foreground="#6B778C"/>
      <WrapPanel Margin="0,18,0,8"><Button Content="Retry quarantined batches" Command="{Binding RetryCommand}"/><Button Content="Export configuration…" Command="{Binding ExportConfigCommand}"/><Button Content="Import configuration…" Command="{Binding ImportConfigCommand}"/></WrapPanel>
      <TextBlock Text="Configuration history" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Restore selected revision" Command="{Binding RestoreCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" DisplayMemberPath="Display"/></DockPanel>
      <TextBlock Text="Restoring creates a new revision. Secrets and measurement history are not overwritten. This preview uses protected administrator access; role-aware operator access is pending." Foreground="#6B778C" TextWrapping="Wrap" Margin="0,14,0,0"/>
     </StackPanel></ScrollViewer>
    </TabItem>
   </TabControl>
   <Border Grid.Row="3" Background="#E9EEF4" Padding="14,11" CornerRadius="6" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#43546B"/></Border>
  </Grid>
 </Grid>
</Window>
